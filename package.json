{
  "name": "gopofajlija",
  "version": "1.0.0",
  "description": "3D Language Galaxy Visualization",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "lint": "eslint js/ src/",
    "lint:fix": "eslint js/ src/ --fix",
    "build": "vite build",
    "build:legacy": "node build.js",
    "build:advanced": "npm run lint && npm run build",
    "minify": "npm run minify:js && npm run minify:css",
    "minify:js": "echo 'Using Vite for bundling and minification'",
    "minify:css": "cleancss -o dist/styles.min.css styles/styles.css",
    "serve": "http-server . -p 8081 -o",
    "serve:dist": "http-server dist -p 8081 -o",
    "dev": "vite",
    "dev:legacy": "npm run lint:fix && npm run serve",
    "preview": "vite preview",
    "clean": "rm -rf dist/*",
    "mp3": "node scripts/mp3.js",
    "audio:analyze": "node scripts/analyze-audio.js",
    "audio:optimize": "node scripts/optimize-audio.js",
    "addLang": "node scripts/addLang.js",
    "i18n": "node scripts/i18n.js"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "culori": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.37.5",
    "fluent-ffmpeg": "^2.1.3",
    "globals": "^17.2.0",
    "http-server": "^14.1.1",
    "terser": "^5.31.1",
    "vite": "^5.4.2"
  },
  "keywords": [
    "languages",
    "visualization",
    "threejs",
    "3d"
  ],
  "author": "Luka Činč Stanisavljević",
  "license": "MIT"
}
