{
  "name": "gopofajlija",
  "version": "1.0.0",
  "description": "3D Language Galaxy Visualization",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "lint": "eslint js/ src/",
    "lint:fix": "eslint js/ src/ --fix",
    "build": "vite build",
    "build:legacy": "node build.js",
    "build:advanced": "npm run lint && npm run build",
    "minify": "npm run minify:js && npm run minify:css",
    "minify:js": "echo 'Using Vite for bundling and minification'",
    "minify:css": "cleancss -o dist/styles.min.css styles/styles.css",
    "serve": "http-server . -p 8080 -o",
    "serve:dist": "http-server dist -p 8080 -o",
    "dev": "vite",
    "dev:legacy": "npm run lint:fix && npm run serve",
    "preview": "vite preview",
    "clean": "rm -rf dist/*",
    "mp3": "node scripts/mp3.js",
    "audio:analyze": "node scripts/analyze-audio.js",
    "audio:optimize": "node scripts/optimize-audio.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.179.1",
    "@react-three/fiber": "^8.17.10",
    "@react-three/drei": "^9.114.3"
  },
  "devDependencies": {
    "vite": "^5.4.2",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "@eslint/js": "^9.10.0",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.31.1",
    "http-server": "^14.1.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "keywords": [
    "languages",
    "visualization",
    "threejs",
    "3d"
  ],
  "author": "Luka Činč Stanisavljević",
  "license": "MIT"
}
