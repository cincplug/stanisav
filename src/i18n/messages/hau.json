    "morphology": {
      "name": "Ilimin sifar kalma",
      "values": {
        "agglutinative": {
          "description": "Ana gina kalmomi ta hanyar ƙara ƙari ɗaya bayan ɗaya, inda kowane ƙari ke ɗauke da ma'ana ɗaya kawai. Sassan suna nan a bayyane kamar tubalan da aka haɗa.",
          "label": "Haɗawa"
        },
        "fusional": {
          "description": "Kalmomi suna canza sifansu ta hanyar ƙarshe da gaban-magana waɗanda ke haɗa ma'anoni da yawa na nahawu a lokaci guda. Ƙarshewa ɗaya na iya bayyana jinsi, lamba, da shari'a tare, wanda ke sa rarrabuwa ya yi wuya.",
          "label": "Haɗuwa"
        },
        "introflexive": {
          "description": "Ana gina nahawu daga cikin kalmar: tushe na baƙaƙe yana ɗauke da ma'anar asali, yayin da tsare-tsaren wasali daban-daban da aka saka cikinsa ke ƙirƙirar sabbin kalmomi. Misali, tushen Larabci k-t-b yana da alaƙa da rubutu, kuma kataba, kitāb da kātib duk sun fito daga gare shi.",
          "label": "Canjin ciki"
        },
        "isolating": {
          "description": "Kalmomi yawanci sun ƙunshi morpheme ɗaya kuma ba sa canza sifansu. Ana bayyana nahawu ta hanyar tsarin kalma da kalmomi na aiki daban-daban maimakon ƙarshe ko gaban-magana.",
          "label": "Rarrabuwa"
        },
        "polysynthetic": {
          "description": "Kalma ɗaya na iya bayyana abin da wasu yarukan za su faɗa a cikin jimla gaba ɗaya, ta hanyar haɗa fi'ili, mai aikata, abin da ake yi masa, da sauran abubuwa tare. Yafi zama gama-gari a cikin yarukan asali na Amurka da Arctic.",
          "label": "Haɗuwa mai yawa"
        }
      }
    },
