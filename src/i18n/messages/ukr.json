    "morphology": {
      "name": "Морфологія",
      "values": {
        "agglutinative": {
          "description": "Слова утворюються нанизуванням афіксів один за одним, де кожен афікс несе рівно одне значення. Частини залишаються чітко впізнаваними, як з'єднані блоки.",
          "label": "Аглютинативна"
        },
        "fusional": {
          "description": "Слова змінюють форму через закінчення та префікси, що поєднують кілька граматичних значень одночасно. Одне закінчення може виражати рід, число й відмінок разом, що ускладнює розділення частин.",
          "label": "Флективна"
        },
        "introflexive": {
          "description": "Граматика вбудована всередину самого слова: корінь із приголосних несе основне значення, а різні голосні патерни, вплетені в нього, утворюють нові слова. Наприклад, арабський корінь k-t-b пов'язаний із писанням, а kataba, kitāb і kātib — усі походять від нього.",
          "label": "Інтрофлективна"
        },
        "isolating": {
          "description": "Слова зазвичай складаються з однієї морфеми і не змінюють форми. Граматика виражається порядком слів і окремими службовими словами, а не закінченнями чи префіксами.",
          "label": "Ізолювальна"
        },
        "polysynthetic": {
          "description": "Одне слово може виражати те, що інші мови сказали б цілим реченням, зливаючи дієслово, підмет, додаток та інші елементи. Характерно для корінних мов Америки та Арктики.",
          "label": "Полісинтетична"
        }
      }
    },
