    "morphology": {
      "name": "ریخت‌شناسی",
      "values": {
        "agglutinative": {
          "description": "کلمات با افزودن وند پشت سر هم ساخته می‌شوند، هر وند دقیقاً یک معنا دارد. اجزا به‌وضوح قابل تشخیص‌اند، مانند قطعاتی که به هم وصل شده‌اند.",
          "label": "التصاقی"
        },
        "fusional": {
          "description": "کلمات از طریق پسوندها و پیشوندهایی که چندین معنای دستوری را با هم بسته‌بندی می‌کنند، شکل خود را تغییر می‌دهند. یک پسوند می‌تواند همزمان جنس، شمار و حالت را بیان کند، که جداسازی اجزا را دشوار می‌سازد.",
          "label": "تصریفی"
        },
        "introflexive": {
          "description": "دستور زبان از درون کلمه ساخته می‌شود: ریشه‌ای از همخوان‌ها معنای اصلی را حمل می‌کند، در حالی که الگوهای متفاوت مصوت که در آن بافته می‌شوند کلمات جدیدی می‌سازند. برای مثال ریشه عربی k-t-b به نوشتن مربوط است، و kataba، kitāb و kātib همه از آن می‌آیند.",
          "label": "درون‌تصریفی"
        },
        "isolating": {
          "description": "کلمات معمولاً از یک تکواژ تشکیل می‌شوند و شکل خود را تغییر نمی‌دهند. دستور زبان از طریق ترتیب کلمات و کلمات نقشی مستقل بیان می‌شود نه پسوند یا پیشوند.",
          "label": "تحلیلی"
        },
        "polysynthetic": {
          "description": "یک کلمه می‌تواند چیزی را بیان کند که زبان‌های دیگر در یک جمله کامل می‌گویند، با ادغام فعل، فاعل، مفعول و سایر عناصر با یکدیگر. در زبان‌های بومی آمریکا و قطب شمال رایج است.",
          "label": "پیوندی"
        }
      }
    },
