    "morphology": {
      "name": "Morfologie",
      "values": {
        "agglutinative": {
          "description": "Woorden worden opgebouwd door affixen achter elkaar te stapelen, waarbij elk affix precies één betekenis draagt. De onderdelen blijven duidelijk herkenbaar, als bouwstenen die in elkaar klikken.",
          "label": "Agglutinerend"
        },
        "fusional": {
          "description": "Woorden veranderen van vorm via uitgangen en prefixen die meerdere grammaticale betekenissen tegelijk bundelen. Eén uitgang kan tegelijk geslacht, getal en naamval uitdrukken, waardoor de onderdelen moeilijk te scheiden zijn.",
          "label": "Fusioneel"
        },
        "introflexive": {
          "description": "Grammatica zit van binnen in het woord ingebouwd: een medeklinkerwortel draagt de kernbetekenis, terwijl verschillende klinkerpatronen die erdoorheen geweven zijn nieuwe woorden vormen. Zo hangt de Arabische wortel k-t-b samen met schrijven, en kataba, kitāb en kātib komen daaruit voort.",
          "label": "Introflexief"
        },
        "isolating": {
          "description": "Woorden bestaan meestal uit één morfeem en veranderen niet van vorm. Grammatica wordt uitgedrukt via woordvolgorde en aparte functiewoorden, in plaats van via uitgangen of prefixen.",
          "label": "Isolerend"
        },
        "polysynthetic": {
          "description": "Eén woord kan uitdrukken wat andere talen in een hele zin zeggen, door werkwoord, onderwerp, object en andere elementen samen te voegen. Komt veel voor in inheemse talen van de Amerika’s en het Noordpoolgebied.",
          "label": "Polysynthetisch"
        }
      }
    },
