    "morphology": {
      "name": "Morfologia",
      "values": {
        "agglutinative": {
          "description": "Słowa tworzy się przez nakładanie przyrostków jeden po drugim, przy czym każdy przyrostek niesie dokładnie jedno znaczenie. Części pozostają wyraźnie rozpoznawalne, jak złączone klocki.",
          "label": "Aglutynacyjna"
        },
        "fusional": {
          "description": "Słowa zmieniają formę przez końcówki i prefiksy skupiające wiele znaczeń gramatycznych naraz. Jedna końcówka może wyrażać rodzaj, liczbę i przypadek jednocześnie, co utrudnia rozdzielenie poszczególnych elementów.",
          "label": "Fleksyjna"
        },
        "introflexive": {
          "description": "Gramatyka jest wbudowana wewnątrz słowa: rdzeń spółgłoskowy niesie znaczenie podstawowe, a różne wzorce samogłoskowe wplecione w ten rdzeń tworzą nowe słowa. Na przykład arabski rdzeń k-t-b odnosi się do pisania, a kataba, kitāb i kātib wszystkie z niego pochodzą.",
          "label": "Introfleksyjna"
        },
        "isolating": {
          "description": "Słowa zazwyczaj składają się z jednego morfemu i nie zmieniają formy. Gramatykę wyraża szyk zdania i osobne wyrazy funkcyjne, a nie końcówki czy prefiksy.",
          "label": "Izolująca"
        },
        "polysynthetic": {
          "description": "Jedno słowo może wyrazić to, co inne języki powiedziałyby całym zdaniem, łącząc czasownik, podmiot, dopełnienie i inne elementy. Typowe dla rdzennych języków Ameryk i Arktyki.",
          "label": "Polisyntetyczna"
        }
      }
    },
