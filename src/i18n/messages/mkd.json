    "morphology": {
      "name": "Морфологија",
      "values": {
        "agglutinative": {
          "description": "Зборовите се градат со низање наставки еден по друг, при што секоја наставка носи точно едно значење. Деловите остануваат јасно препознатливи, како споени коцки.",
          "label": "Аглутинативна"
        },
        "fusional": {
          "description": "Зборовите го менуваат обликот преку наставки и префикси кои истовремено носат повеќе граматички значења. Една наставка може да изразува род, број и падеж одеднаш, што ги прави деловите тешко разделиви.",
          "label": "Флексивна"
        },
        "introflexive": {
          "description": "Граматиката е вградена внатре во самиот збор: корен од согласници го носи основното значење, додека различни вокални обрасци исткаени низ него создаваат нови зборови. На пример, арапскиот корен k-t-b се однесува на пишување, а kataba, kitāb и kātib сите потекнуваат од него.",
          "label": "Интрофлексивна"
        },
        "isolating": {
          "description": "Зборовите обично се состојат од еден морфем и не го менуваат обликот. Граматиката се изразува преку редот на зборовите и посебни функциски зборови, а не преку наставки или префикси.",
          "label": "Изолативна"
        },
        "polysynthetic": {
          "description": "Еден збор може да изрази она што другите јазици би го кажале со цела реченица, со спојување на глаголот, субјектот, објектот и другите елементи. Вообичаено кај автохтоните јазици на Америка и Арктикот.",
          "label": "Полисинтетичка"
        }
      }
    },
