    "morphology": {
      "name": "රූප විද්‍යාව",
      "values": {
        "agglutinative": {
          "description": "වචන ගොඩනගනු ලබන්නේ එකිනෙකට ආකෘති ඇමිණීමෙනි; එක් එක් ආකෘතිය හරියටම එක් අර්ථයක් ගෙන යයි. කොටස් ගොඩනැගිලි ඇණ ගැනෙනවා සේ පැහැදිලිව හඳුනා ගත හැකිය.",
          "label": "ඇකූලිනේටිව්"
        },
        "fusional": {
          "description": "වචන ඒකවචන/බහුවචන/කාරකාදිය ඒකාබද්ධ ගොනු ලෙස ප්‍රකාශ කරන අවසාන හා උපසර්ග හරහා ස්වරූප වෙනස් කරයි. එකම අවසානය ලිංගය, ගණය සහ කාරකය ඒකවරම ප්‍රකාශ කළ හැකිය.",
          "label": "ෆ්‍යූෂනල්"
        },
        "introflexive": {
          "description": "ව්‍යාකරණය වචනයේ ඇතුළතින් ගොඩනැගේ: ව්‍යාංජන මූලයක් මූලාර්ථය ගෙන යයි, එය හරහා වෙනස් ස්වර රටා නව වචන සාදයි. නිදසුනක් ලෙස, අරාබි k-t-b මූලය ලිවීම ඇසෙනු සහ kataba, kitāb, kātib ඉන් ලැබේ.",
          "label": "ඉන්ට්‍රෝෆ්ලෙක්සිව්"
        },
        "isolating": {
          "description": "වචන සාමාන්‍යයෙන් තනි රූපකාංගවලින් සමන්විත වන අතර ස්වරූප වෙනස් නොකරයි. ව්‍යාකරණය ප්‍රකාශ කරනු ලබන්නේ වචන අනුපිළිවෙල හා වෙනම ක්‍රියා-ශ්‍රේණී වචන මඟිනි.",
          "label": "අයිසොලේටිං"
        },
        "polysynthetic": {
          "description": "එක් වචනයක් ක්‍රියාව, විෂය, කර්මය සහ වෙනත් අංග ඒකාබද්ධ කරමින් වෙනත් භාෂාවල සම්පූර්ණ වාක්‍යයකින් කියයි. ඇමරිකාවේ හා ආර්කිටික් ස්වදේශිකයින්ගේ භාෂාවල සාමාන්‍ය.",
