    "morphology": {
      "name": "रूपविज्ञान",
      "values": {
        "agglutinative": {
          "description": "शब्द एक के बाद एक प्रत्यय जोड़कर बनाए जाते हैं, जहाँ प्रत्येक प्रत्यय ठीक एक अर्थ वहन करता है। भाग स्पष्ट रूप से पहचाने जाने योग्य रहते हैं, जैसे जुड़े हुए खंड।",
          "label": "योगात्मक"
        },
        "fusional": {
          "description": "शब्द अंत और उपसर्गों के माध्यम से अपना रूप बदलते हैं जो एक साथ कई व्याकरणिक अर्थ बंडल करते हैं। एक ही अंत लिंग, वचन और कारक एक साथ व्यक्त कर सकती है, जिससे भागों को अलग करना कठिन हो जाता है।",
          "label": "रूपान्तरी"
        },
        "introflexive": {
          "description": "व्याकरण शब्द के भीतर से बनता है: व्यंजनों की एक मूल मूल अर्थ वहन करती है, जबकि उसमें बुने गए विभिन्न स्वर पैटर्न नए शब्द बनाते हैं। उदाहरण के लिए अरबी मूल k-t-b लेखन से संबंधित है, और kataba, kitāb तथा kātib सभी इससे आते हैं।",
          "label": "आंतरिक रूपान्तरी"
        },
        "isolating": {
          "description": "शब्द आमतौर पर एकल रूपिम से बने होते हैं और अपना रूप नहीं बदलते। व्याकरण शब्द क्रम और अलग कार्य शब्दों के माध्यम से व्यक्त होता है न कि अंत या उपसर्गों से।",
          "label": "वियोगात्मक"
        },
        "polysynthetic": {
          "description": "एक शब्द वह व्यक्त कर सकता है जो अन्य भाषाएँ पूरे वाक्य में कहती हैं, क्रिया, कर्ता, कर्म और अन्य तत्वों को एक साथ जोड़कर। अमेरिका और आर्कटिक की स्वदेशी भाषाओं में सामान्य।",
          "label": "बहुसंश्लेषी"
        }
      }
    },
