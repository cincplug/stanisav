    "morphology": {
      "name": "Morphologie",
      "values": {
        "agglutinative": {
          "description": "Les mots se forment en empilant des affixes les uns après les autres, chaque affixe portant exactement un sens. Les parties restent clairement reconnaissables, comme des briques assemblées.",
          "label": "Agglutinante"
        },
        "fusional": {
          "description": "Les mots changent de forme par des désinences et des préfixes qui regroupent plusieurs sens grammaticaux à la fois. Une seule désinence peut exprimer le genre, le nombre et le cas simultanément, rendant difficile la séparation des parties.",
          "label": "Flexionnelle"
        },
        "introflexive": {
          "description": "La grammaire est intégrée à l'intérieur du mot : une racine de consonnes porte le sens central, tandis que différents schémas vocaliques tissés à travers elle créent de nouveaux mots. Par exemple, la racine arabe k-t-b est liée à l'écriture, et kataba, kitāb et kātib en dérivent tous.",
          "label": "Introflexive"
        },
        "isolating": {
          "description": "Les mots se composent généralement d'un seul morphème et ne changent pas de forme. La grammaire s'exprime par l'ordre des mots et des mots fonctionnels séparés, plutôt que par des désinences ou des préfixes.",
          "label": "Isolante"
        },
        "polysynthetic": {
          "description": "Un seul mot peut exprimer ce que d'autres langues diraient dans une phrase entière, en fusionnant le verbe, le sujet, l'objet et d'autres éléments. Fréquent dans les langues autochtones des Amériques et de l'Arctique.",
          "label": "Polysynthétique"
        }
      }
    },
