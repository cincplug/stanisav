    "morphology": {
      "name": "Morfoloji",
      "values": {
        "agglutinative": {
          "description": "Sözcükler, her birinin tam olarak bir anlam taşıdığı ekler art arda eklenerek oluşturulur. Parçalar, birbirine geçirilmiş yapı taşları gibi açıkça tanınabilir kalır.",
          "label": "Eklemeli"
        },
        "fusional": {
          "description": "Sözcükler, aynı anda birden fazla dilbilgisel anlam içeren sonekler ve öneklerle biçimlerini değiştirir. Tek bir sonek cinsiyet, sayı ve durumu aynı anda ifade edebilir; bu da parçaları birbirinden ayırmayı güçleştirir.",
          "label": "Bükünlü"
        },
        "introflexive": {
          "description": "Dilbilgisi sözcüğün içinden kurulur: ünsüzlerden oluşan bir kök temel anlamı taşır; içine dokunan farklı ünlü örüntüleri yeni sözcükler oluşturur. Örneğin Arapçadaki k-t-b kökü yazmaya ilişkindir ve kataba, kitāb ile kātib hepsi buradan gelir.",
          "label": "İçten bükünlü"
        },
        "isolating": {
          "description": "Sözcükler genellikle tek bir morfemden oluşur ve biçimlerini değiştirmez. Dilbilgisi, sonekler ya da önekler yerine sözcük sırası ve ayrı işlev sözcükleri aracılığıyla ifade edilir.",
          "label": "Yalıtımlı"
        },
        "polysynthetic": {
          "description": "Tek bir sözcük, diğer dillerin tüm cümlede söyleyeceği şeyi, fiil, özne, nesne ve diğer unsurları bir araya getirerek ifade edebilir. Amerika'nın ve Arktik'in yerli dillerinde yaygındır.",
          "label": "Çok bireşimli"
        }
      }
    },
