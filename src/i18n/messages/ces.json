      "name": "Morfologie",
      "values": {
        "agglutinative": {
          "description": "Slova se tvoří řazením přípon za sebou, přičemž každá přípona nese právě jeden význam. Části zůstávají jasně rozpoznatelné, jako spojené stavebnice.",
          "label": "Aglutinační"
        },
        "fusional": {
          "description": "Slova mění svůj tvar pomocí koncovek a předpon, které zároveň nesou více gramatických významů. Jediná koncovka může vyjadřovat rod, číslo a pád najednou, což části ztěžuje oddělení.",
          "label": "Flektivní"
        },
        "introflexive": {
          "description": "Gramatika je zabudována dovnitř slova: kořen ze souhlásek nese základní význam, zatímco různé samohláskové vzory do něj vetkané vytvářejí nová slova. Například arabský kořen k-t-b se vztahuje k psaní a kataba, kitāb i kātib z něj všechny pocházejí.",
          "label": "Introflektivní"
        },
        "isolating": {
          "description": "Slova se obvykle skládají z jediného morfému a nemění svůj tvar. Gramatika se vyjadřuje slovosledem a samostatnými funkčními slovy, nikoli koncovkami nebo předponami.",
          "label": "Izolační"
        },
        "polysynthetic": {
          "description": "Jediné slovo může vyjádřit to, co by jiné jazyky řekly celou větou, sloučením slovesa, podmětu, předmětu a dalších prvků. Typické pro domorodé jazyky Ameriky a Arktidy.",
          "label": "Polysyntetická"
        }
      }
    },
