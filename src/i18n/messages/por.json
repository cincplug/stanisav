    "maxClusterSize": {
      "name": "Máx. consoantes num grupo"
    },
    "morphology": {
      "name": "Morfologia",
      "values": {
        "agglutinative": {
          "description": "As palavras formam-se empilhando afixos um após outro, onde cada afixo carrega exatamente um significado. As partes permanecem claramente reconhecíveis, como peças encaixadas.",
          "label": "Aglutinante"
        },
        "fusional": {
          "description": "As palavras mudam de forma através de desinências e prefixos que agrupam vários significados gramaticais ao mesmo tempo. Uma única desinência pode expressar género, número e caso simultaneamente, dificultando a separação das partes.",
          "label": "Flexional"
        },
        "introflexive": {
          "description": "A gramática está integrada no interior da própria palavra: uma raiz de consoantes carrega o significado central, enquanto diferentes padrões vocálicos entrelaçados nela criam novas palavras. Por exemplo, a raiz árabe k-t-b relaciona-se com a escrita, e kataba, kitāb e kātib derivam todas dela.",
          "label": "Introflexiva"
        },
        "isolating": {
          "description": "As palavras consistem tipicamente num único morfema e não mudam de forma. A gramática é expressa pela ordem das palavras e por palavras funcionais separadas, e não por desinências ou prefixos.",
          "label": "Isolante"
        },
        "polysynthetic": {
          "description": "Uma única palavra pode expressar o que outras línguas diriam numa frase inteira, fundindo o verbo, o sujeito, o objeto e outros elementos. Comum nas línguas indígenas das Américas e do Ártico.",
          "label": "Polissintética"
        }
      }
    },
