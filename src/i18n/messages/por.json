    "evidentiality": {
      "name": "Evidencialidade",
      "values": {
        "complex": {
          "description": "Quatro ou mais distinções evidenciais ou evidencialidade fundida com tempo/aspeto.",
          "label": "Complexa"
        },
        "moderate": {
          "description": "Distinção tripla (p. ex., direta, reportada, inferencial).",
          "label": "Moderada"
        },
        "none": {
          "description": "Sem marcação gramatical da fonte de informação.",
          "label": "Nenhuma"
        },
        "optional": {
          "description": "Existem marcadores semelhantes aos evidenciais mas não são obrigatórios.",
          "label": "Opcional"
        },
        "simple": {
          "description": "Distinção binária (tipicamente direta vs. indireta/reportada).",
          "label": "Simples"
        }
