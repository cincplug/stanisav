    "morphology": {
      "name": "الصرف",
      "values": {
        "agglutinative": {
          "description": "تُبنى الكلمات بتراكم اللواصق واحدة تلو الأخرى، إذ تحمل كل لاصقة معنىً واحداً بعينه. تظل الأجزاء واضحة ومتميزة كالمكعبات المتشابكة.",
          "label": "إلصاقية"
        },
        "fusional": {
          "description": "تتغير الكلمات بالنهايات والسوابق التي تدمج معاني نحوية متعددة في آنٍ واحد. فقد تعبر نهاية واحدة عن الجنس والعدد والإعراب معاً، مما يجعل الفصل بين الأجزاء أمراً عسيراً.",
          "label": "اندماجية"
        },
        "introflexive": {
          "description": "تُبنى القواعد من داخل الكلمة: جذر من الصوامت يحمل المعنى الأساسي، وأنماط متباينة من الحركات تنسج خلاله لتُكوّن كلمات جديدة. فمثلاً الجذر العربي ك-ت-ب يرتبط بالكتابة، وتنبثق منه كلمات: كَتَبَ وكِتَاب وكَاتِب.",
          "label": "تحويلية داخلية"
        },
        "isolating": {
          "description": "تتألف الكلمات عادةً من مورفيم واحد ولا تتغير صيغتها. يُعبَّر عن القواعد النحوية بترتيب الكلمات وأدوات الوظيفة المستقلة لا بالنهايات أو السوابق.",
          "label": "عازلة"
        },
        "polysynthetic": {
          "description": "يمكن لكلمة واحدة أن تؤدي ما تؤديه جملة كاملة في لغات أخرى، بدمج الفعل والفاعل والمفعول وعناصر أخرى معاً. شائعة في اللغات الأصلية للأمريكتين ومنطقة القطب الشمالي.",
          "label": "تجميعية متشعبة"
        }
      }
    },
