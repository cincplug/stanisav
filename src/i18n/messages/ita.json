    "evidentiality": {
      "name": "Evidenzialità",
      "values": {
        "complex": {
          "description": "Quattro o più distinzioni evidenziali o evidenzialità fusa con tempo/aspetto.",
          "label": "Complessa"
        },
        "moderate": {
          "description": "Distinzione a tre vie (es. diretta, riportata, inferenziale).",
          "label": "Moderata"
        },
        "none": {
          "description": "Nessuna marcatura grammaticale della fonte dell'informazione.",
          "label": "Assente"
        },
        "optional": {
          "description": "Esistono marcatori simili a quelli evidenziali ma non sono obbligatori.",
          "label": "Opzionale"
        },
        "simple": {
          "description": "Distinzione binaria (tipicamente diretta vs. indiretta/riportata).",
          "label": "Semplice"
        }
