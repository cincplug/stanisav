    "maxClusterSize": {
      "name": "Max. consonanti in un gruppo"
    },
    "morphology": {
      "name": "Morfologia",
      "values": {
        "agglutinative": {
          "description": "Le parole si formano aggiungendo suffissi uno dopo l'altro, dove ogni suffisso porta esattamente un significato. Le parti rimangono chiaramente riconoscibili, come mattoncini incastrati.",
          "label": "Agglutinante"
        },
        "fusional": {
          "description": "Le parole cambiano forma attraverso desinenze e prefissi che racchiudono più significati grammaticali contemporaneamente. Una sola desinenza può esprimere genere, numero e caso insieme, rendendo difficile separare le parti.",
          "label": "Flessiva"
        },
        "introflexive": {
          "description": "La grammatica è costruita all'interno della parola stessa: una radice di consonanti porta il significato centrale, mentre diversi schemi vocalici intrecciati creano nuove parole. Ad esempio, la radice araba k-t-b riguarda la scrittura, e kataba, kitāb e kātib derivano tutti da essa.",
          "label": "Introflessa"
        },
        "isolating": {
          "description": "Le parole sono tipicamente composte da singoli morfemi e non cambiano forma. La grammatica è espressa dall'ordine delle parole e da parole funzionali separate, piuttosto che da desinenze o prefissi.",
          "label": "Isolante"
        },
        "polysynthetic": {
          "description": "Una singola parola può esprimere ciò che altre lingue direbbero in un'intera frase, fondendo verbo, soggetto, oggetto e altri elementi insieme. Comune nelle lingue indigene delle Americhe e dell'Artico.",
          "label": "Polisintetica"
        }
      }
    },
