          "label": "இல்லை"
        },
        "optional": {
          "description": "சான்று போன்ற குறியீடுகள் உள்ளன ஆனால் கட்டாயமில்லை.",
          "label": "விருப்பத்தேர்வு"
        },
        "simple": {
          "description": "இரண்டு வழி வேறுபாடு (பொதுவாக நேரடி எதிராக மறைமுக/அறிவிப்பு).",
          "label": "எளிமையான"
        }
      }
    },
    "family": {
      "name": "மொழிக் குடும்பம்"
    },
    "maxClusterSize": {
      "name": "ஒரு கொத்தில் அதிகபட்ச மெய்யெழுத்துகள்"
    },
    "morphology": {
      "name": "சொல்லமைப்பியல்",
      "values": {
        "agglutinative": {
          "description": "சொற்கள் ஒன்றன்பின் ஒன்றாக விகுதிகளை சேர்ப்பதால் உருவாகின்றன, ஒவ்வொரு விகுதியும் சரியாக ஒரு பொருளை மட்டுமே கொண்டிருக்கும். பாகங்கள் தெளிவாக அடையாளம் காணக்கூடியதாக இருக்கும், ஒன்றோடொன்று பொருத்தப்பட்ட தொகுதிகள் போல.",
          "label": "ஒட்டுமொழி"
        },
        "fusional": {
          "description": "சொற்கள் விகுதிகள் மற்றும் முன்னொட்டுகள் மூலம் தங்கள் வடிவத்தை மாற்றுகின்றன, அவை ஒரே நேரத்தில் பல இலக்கண பொருள்களை கொண்டிருக்கும். ஒரு விகுதியே பால், எண் மற்றும் வேற்றுமையை ஒரே நேரத்தில் வெளிப்படுத்தலாம், பாகங்களை பிரிப்பதை கடினமாக்குகிறது.",
          "label": "இணைவு மொழி"
        },
        "introflexive": {
          "description": "இலக்கணம் சொல்லின் உள்ளிருந்து கட்டமைக்கப்படுகிறது: மெய்யெழுத்துகளின் வேர் மையப்பொருளை சுமக்கிறது, அதில் நெய்யப்பட்ட வெவ்வேறு உயிரெழுத்து வடிவங்கள் புதிய சொற்களை உருவாக்குகின்றன. எடுத்துக்காட்டாக, அரபி வேர் k-t-b எழுத்துடன் தொடர்புடையது, மற்றும் kataba, kitāb மற்றும் kātib அனைத்தும் அதிலிருந்து வருகின்றன.",
          "label": "உள் மாற்று மொழி"
        },
        "isolating": {
          "description": "சொற்கள் பொதுவாக ஒரே ஒரு உருபனால் ஆனவை மற்றும் தங்கள் வடிவத்தை மாற்றுவதில்லை. இலக்கணம் சொல் வரிசை மற்றும் தனி செயல்பாட்டு சொற்கள் மூலம் வெளிப்படுத்தப்படுகிறது, விகுதிகள் அல்லது முன்னொட்டுகள் மூலம் அல்ல.",
          "label": "தனிமொழி"
        },
        "polysynthetic": {
          "description": "ஒரு சொல்லே மற்ற மொழிகள் முழு வாக்கியத்தில் சொல்வதை வெளிப்படுத்த முடியும், வினை, எழுவாய், செயப்படுபொருள் மற்றும் பிற கூறுகளை ஒன்றாக இணைத்து. அமெரிக்கா மற்றும் ஆர்க்டிக்கின் பழங்குடி மொழிகளில் பொதுவானது.",
          "label": "பல்லிணைவு மொழி"
        }
      }
    },
