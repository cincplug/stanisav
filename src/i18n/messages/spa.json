    "evidentiality": {
      "name": "Evidencialidad",
      "values": {
        "complex": {
          "description": "Cuatro o más distinciones evidenciales o evidencialidad fusionada con tiempo/aspecto.",
          "label": "Compleja"
        },
        "moderate": {
          "description": "Distinción triple (p. ej., directa, reportada, inferencial).",
          "label": "Moderada"
        },
        "none": {
          "description": "Sin marcación gramatical de la fuente de información.",
          "label": "Ninguna"
        },
        "optional": {
          "description": "Existen marcadores similares a los evidenciales pero no son obligatorios.",
          "label": "Opcional"
        },
        "simple": {
          "description": "Distinción binaria (típicamente directa vs. indirecta/reportada).",
          "label": "Simple"
        }
      }
    },
    "family": {
      "name": "Familia lingüística"
