    "maxClusterSize": {
      "name": "Máx. consonantes en un grupo"
    },
    "morphology": {
      "name": "Morfología",
      "values": {
        "agglutinative": {
          "description": "Las palabras se forman apilando afijos uno tras otro, donde cada afijo lleva exactamente un significado. Las partes permanecen claramente reconocibles, como piezas ensambladas.",
          "label": "Aglutinante"
        },
        "fusional": {
          "description": "Las palabras cambian su forma mediante desinencias y prefijos que agrupan múltiples significados gramaticales a la vez. Una sola desinencia puede expresar género, número y caso simultáneamente, dificultando separar las partes.",
          "label": "Flexiva"
        },
        "introflexive": {
          "description": "La gramática está integrada dentro de la propia palabra: una raíz de consonantes porta el significado central, mientras que distintos patrones vocálicos entretejidos en ella crean nuevas palabras. Por ejemplo, la raíz árabe k-t-b se relaciona con la escritura, y kataba, kitāb y kātib provienen todas de ella.",
          "label": "Introflexiva"
        },
        "isolating": {
          "description": "Las palabras suelen constar de un solo morfema y no cambian de forma. La gramática se expresa mediante el orden de las palabras y palabras funcionales independientes, no mediante desinencias o prefijos.",
          "label": "Aislante"
        },
        "polysynthetic": {
          "description": "Una sola palabra puede expresar lo que otros idiomas dirían en toda una oración, fusionando el verbo, el sujeto, el objeto y otros elementos. Común en las lenguas indígenas de las Américas y el Ártico.",
          "label": "Polisintética"
        }
      }
    },
    "nounClassCount": {
      "name": "Clases nominales / géneros"
