    "evidentiality": {
      "name": "証拠性",
      "values": {
        "complex": {
          "description": "4種類以上の証拠性の区別、またはテンス・アスペクトと融合した証拠性。",
          "label": "複雑"
        },
        "moderate": {
          "description": "3項対立（例：直接・伝聞・推論）。",
          "label": "中程度"
        },
        "none": {
          "description": "情報源の文法的マーキングなし。",
          "label": "なし"
        },
        "optional": {
          "description": "証拠性に似たマーカーは存在するが、義務的ではない。",
          "label": "任意"
        },
        "simple": {
          "description": "2項対立（一般的に直接証拠と間接証拠・伝聞の区別）。",
          "label": "単純"
        }
      }
    },
    "family": {
      "name": "語族"
    },
    "maxConsonantClusterSize": {
      "name": "子音クラスターの最大子音数"
    },
    "morphology": {
      "name": "形態論",
      "values": {
        "agglutinative": {
          "description": "語は接辞を次々と積み重ねることで形成され、各接辞はひとつの意味のみを担う。各部分は積み木のようにはっきりと識別できる。",
          "label": "膠着語"
        },
        "fusional": {
          "description": "語は複数の文法的意味を一度に束ねた語尾や接頭辞によって形を変える。ひとつの語尾が性・数・格を同時に表すことがあり、各部分を切り離すことが難しい。",
          "label": "屈折語"
        },
        "introflexive": {
          "description": "文法は語の内部から構築される。子音からなる語根が核心的な意味を担い、そこに織り込まれる異なる母音パターンが新しい語を生み出す。例えばアラビア語の語根 k-t-b は「書く」に関連し、kataba・kitāb・kātib はすべてそこから派生する。",
          "label": "内屈折語"
        },
        "isolating": {
          "description": "語は通常ひとつの形態素からなり、形を変えない。文法は語順や独立した機能語によって表され、語尾や接頭辞には依存しない。",
          "label": "孤立語"
        },
        "polysynthetic": {
          "description": "ひとつの語が、他の言語では文全体で表すような内容を表現できる。動詞・主語・目的語などの要素が融合している。南北アメリカや北極圏の先住民言語に多く見られる。",
          "label": "抱合語"
        }
      }
    },
