    "morphology": {
      "name": "Morfologi",
      "values": {
        "agglutinative": {
          "description": "Ord bygges ved at stable affikser efter hinanden, hvor hvert affiks bærer præcis én betydning. Delene forbliver tydeligt genkendelige, som byggeklodser sat sammen.",
          "label": "Agglutinerende"
        },
        "fusional": {
          "description": "Ord ændrer form gennem endelser og forstavelser, der bundter flere grammatiske betydninger på én gang. En enkelt endelse kan udtrykke køn, tal og kasus samtidig, hvilket gør delene svære at adskille.",
          "label": "Fusionerende"
        },
        "introflexive": {
          "description": "Grammatikken er indbygget i ordet indefra: en rod af konsonanter bærer kernebetydningen, mens forskellige vokalmønstre vævet igennem den skaber nye ord. For eksempel relaterer den arabiske rod k-t-b sig til at skrive, og kataba, kitāb og kātib stammer alle derfra.",
          "label": "Introflektiv"
        },
        "isolating": {
          "description": "Ord består typisk af enkelte morfemer og ændrer ikke form. Grammatik udtrykkes gennem ordstilling og separate funktionsord frem for endelser eller forstavelser.",
          "label": "Isolerende"
        },
        "polysynthetic": {
          "description": "Et enkelt ord kan udtrykke det, andre sprog ville sige i en hel sætning, ved at smelte verbum, subjekt, objekt og andre led sammen. Almindeligt i oprindelige sprog i Amerika og Arktis.",
          "label": "Polysyntetisk"
        }
      }
    },
