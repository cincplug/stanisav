    "morphology": {
      "name": "형태론",
      "values": {
        "agglutinative": {
          "description": "단어는 접사를 하나씩 차례로 붙여 형성되며, 각 접사는 정확히 하나의 의미를 담는다. 각 부분은 맞물린 블록처럼 명확히 구분된다.",
          "label": "교착어"
        },
        "fusional": {
          "description": "단어는 여러 문법적 의미를 한꺼번에 묶는 어미와 접두사를 통해 형태를 바꾼다. 하나의 어미가 성·수·격을 동시에 나타낼 수 있어 각 부분을 분리하기 어렵다.",
          "label": "굴절어"
        },
        "introflexive": {
          "description": "문법이 단어 내부에서 구성된다. 자음으로 이루어진 어근이 핵심 의미를 담고, 그 안에 짜인 다양한 모음 패턴이 새로운 단어를 만든다. 예를 들어 아랍어 어근 k-t-b는 쓰기와 관련되며, kataba·kitāb·kātib가 모두 여기서 파생된다.",
          "label": "내부 굴절어"
        },
        "isolating": {
          "description": "단어는 일반적으로 하나의 형태소로 이루어지며 형태를 바꾸지 않는다. 문법은 어미나 접두사가 아닌 어순과 별도의 기능어로 표현된다.",
          "label": "고립어"
        },
        "polysynthetic": {
          "description": "하나의 단어가 다른 언어에서 문장 전체로 표현할 내용을 동사·주어·목적어 등을 융합하여 나타낼 수 있다. 아메리카 및 북극 지역의 토착 언어에 많다.",
          "label": "포합어"
        }
      }
    },
