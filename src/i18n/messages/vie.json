    "morphology": {
      "name": "Hình thái học",
      "values": {
        "agglutinative": {
          "description": "Từ được tạo thành bằng cách xếp chồng các phụ tố lên nhau, trong đó mỗi phụ tố mang đúng một nghĩa. Các phần vẫn có thể nhận ra rõ ràng, như những khối ghép lại với nhau.",
          "label": "Kết dính"
        },
        "fusional": {
          "description": "Từ thay đổi hình thức qua các hậu tố và tiền tố gói gọn nhiều nghĩa ngữ pháp cùng một lúc. Một hậu tố có thể diễn đạt giống, số và cách đồng thời, khiến các phần khó tách rời.",
          "label": "Khuất chiết"
        },
        "introflexive": {
          "description": "Ngữ pháp được xây dựng từ bên trong từ: một gốc phụ âm mang nghĩa cốt lõi, trong khi các mẫu nguyên âm khác nhau được dệt vào đó tạo ra các từ mới. Ví dụ, gốc tiếng Ả Rập k-t-b liên quan đến viết, và kataba, kitāb và kātib đều đến từ đó.",
          "label": "Khuất chiết nội tại"
        },
        "isolating": {
          "description": "Từ thường bao gồm một hình vị duy nhất và không thay đổi hình thức. Ngữ pháp được thể hiện qua trật tự từ và các từ chức năng riêng biệt thay vì hậu tố hay tiền tố.",
          "label": "Đơn lập"
        },
        "polysynthetic": {
          "description": "Một từ duy nhất có thể diễn đạt những gì các ngôn ngữ khác phải nói trong cả một câu, bằng cách kết hợp động từ, chủ ngữ, tân ngữ và các yếu tố khác lại với nhau. Phổ biến trong các ngôn ngữ bản địa của châu Mỹ và Bắc Cực.",
          "label": "Tổng hợp đa phức"
        }
      }
    },
