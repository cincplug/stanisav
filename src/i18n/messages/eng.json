  "linguistic": {
    "caseCount": {
      "name": "Case count"
    },
    "evidentiality": {
      "name": "Evidentiality",
      "values": {
        "complex": {
          "description": "Four or more evidential distinctions or evidentiality fused with tense/aspect.",
          "label": "Complex"
        },
        "moderate": {
          "description": "Three-way distinction (e.g., direct, reportative, inferential).",
          "label": "Moderate"
        },
        "none": {
          "description": "No grammatical marking of information source.",
          "label": "None"
        },
        "optional": {
          "description": "Evidential-like markers exist but are not obligatory.",
          "label": "Optional"
        },
        "simple": {
          "description": "Two-way distinction (typically direct vs. indirect/reportative).",
          "label": "Simple"
        }
      }
    },
    "family": {
      "name": "Language family"
    },
    "maxClusterSize": {
      "name": "Max consonants in a cluster"
    },
    "morphology": {
      "name": "Morphology",
      "values": {
        "agglutinative": {
          "description": "Words are built by stacking affixes one after another, where each affix carries exactly one meaning. The pieces stay clearly recognizable, like building blocks snapped together.",
          "label": "Agglutinative"
        },
        "fusional": {
          "description": "Words change their form through endings and prefixes that bundle multiple grammatical meanings at once. A single ending might express gender, number, and case simultaneously, making the pieces hard to pull apart.",
          "label": "Fusional"
        },
        "introflexive": {
          "description": "Grammar is built into the word from the inside: a root of consonants carries the core meaning, while different vowel patterns woven through it create new words. For example, the Arabic root k-t-b relates to writing, and kataba, kitāb, and kātib all come from it.",
          "label": "Introflexive"
        },
        "isolating": {
          "description": "Words typically consist of single morphemes and don't change their form. Grammar is expressed through word order and separate function words rather than endings or prefixes.",
          "label": "Isolating"
        },
        "polysynthetic": {
          "description": "A single word can express what other languages would say in a whole sentence, by fusing the verb, subject, object, and other elements together. Common in indigenous languages of the Americas and the Arctic.",
          "label": "Polysynthetic"
        }
      }
    },
    "nounClassCount": {
      "name": "Noun classes / genders"
    },
    "phonemeCount": {
      "name": "Phoneme count"
    },
