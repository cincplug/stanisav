    "morphology": {
      "name": "Morfologija",
      "values": {
        "agglutinative": {
          "description": "Reči se grade nizanjem nastavaka jedan za drugim, pri čemu svaki nastavak nosi tačno jedno značenje. Delovi ostaju jasno prepoznatljivi, poput spojenih kockica.",
          "label": "Aglutinativna"
        },
        "fusional": {
          "description": "Reči menjaju oblik kroz nastavke i prefikse koji istovremeno nose više gramatičkih značenja. Jedan nastavak može izražavati rod, broj i padež odjednom, što delove čini teško razdvojivim.",
          "label": "Fleksivna"
        },
        "introflexive": {
          "description": "Gramatika je ugrađena unutar same reči: koren od suglasnika nosi osnovno značenje, dok različiti vokalni obrasci istkani kroz njega stvaraju nove reči. Na primer, arapski koren k-t-b odnosi se na pisanje, a kataba, kitāb i kātib svi potiču od njega.",
          "label": "Introfleksivna"
        },
        "isolating": {
          "description": "Reči se obično sastoje od jednog morfema i ne menjaju oblik. Gramatika se izražava redom reči i posebnim funkcijskim rečima, a ne nastavcima ili prefiksima.",
          "label": "Izolativna"
        },
        "polysynthetic": {
          "description": "Jedna reč može izraziti ono što bi drugi jezici rekli čitavom rečenicom, spajanjem glagola, subjekta, objekta i ostalih elemenata. Karakteristično za autohtone jezike Amerike i Arktika.",
          "label": "Polisintetička"
        }
      }
    },
