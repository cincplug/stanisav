    "morphology": {
      "name": "Mofolojia",
      "values": {
        "agglutinative": {
          "description": "Maneno huundwa kwa kuongeza viambishi kimoja baada ya kingine, ambapo kila kiambishi hubeba maana moja tu. Sehemu hubaki zinazoonekana wazi, kama vipande vilivyounganishwa.",
          "label": "Uongezaji"
        },
        "fusional": {
          "description": "Maneno hubadilisha umbo lake kupitia viishio na viambishi awali vinavyounganisha maana nyingi za kisarufi kwa wakati mmoja. Kiishio kimoja kinaweza kuonyesha jinsia, idadi, na hali kwa pamoja, na kufanya vigumu kutenganisha sehemu.",
          "label": "Muunganiko"
        },
        "introflexive": {
          "description": "Sarufi hujengwa ndani ya neno: mzizi wa konsonanti hubeba maana kuu, huku mifumo tofauti ya irabu iliyosukwa ndani yake ikiumba maneno mapya. Kwa mfano, mzizi wa Kiarabu k-t-b unahusiana na uandishi, na kataba, kitāb na kātib wote hutoka humo.",
          "label": "Mabadiliko ya ndani"
        },
        "isolating": {
          "description": "Maneno kwa kawaida yana mofimu moja tu na hayabadilishi umbo lake. Sarufi huonyeshwa kupitia mpangilio wa maneno na maneno ya kazi tofauti badala ya viishio au viambishi awali.",
          "label": "Utengano"
        },
        "polysynthetic": {
          "description": "Neno moja linaweza kueleza kile ambacho lugha nyingine zingesema katika sentensi nzima, kwa kuunganisha kitenzi, mtenda, kitendwa, na vipengele vingine pamoja. Kawaida katika lugha za asili za Amerika na Aktiki.",
          "label": "Uunganiko mwingi"
        }
      }
    },
