    "morphology": {
      "name": "Morfologi",
      "values": {
        "agglutinative": {
          "description": "Kata dibentuk dengan menumpuk imbuhan satu per satu, di mana setiap imbuhan membawa tepat satu makna. Bagian-bagiannya tetap dapat dikenali dengan jelas, seperti balok-balok yang disatukan.",
          "label": "Aglutinasi"
        },
        "fusional": {
          "description": "Kata mengubah bentuknya melalui akhiran dan prefiks yang sekaligus menggabungkan beberapa makna gramatikal. Satu akhiran bisa mengungkapkan gender, jumlah, dan kasus secara bersamaan, sehingga sulit untuk memisahkan bagian-bagiannya.",
          "label": "Fleksi"
        },
        "introflexive": {
          "description": "Tata bahasa dibangun dari dalam kata: akar konsonan membawa makna inti, sementara pola vokal berbeda yang disisipkan ke dalamnya membentuk kata-kata baru. Misalnya, akar bahasa Arab k-t-b berkaitan dengan tulisan, dan kataba, kitāb, serta kātib semuanya berasal darinya.",
          "label": "Introfleksi"
        },
        "isolating": {
          "description": "Kata biasanya terdiri dari satu morfem dan tidak mengubah bentuknya. Tata bahasa dinyatakan melalui urutan kata dan kata fungsi terpisah, bukan melalui akhiran atau prefiks.",
          "label": "Isolasi"
        },
        "polysynthetic": {
          "description": "Satu kata dapat mengungkapkan apa yang akan dikatakan bahasa lain dalam kalimat penuh, dengan menyatukan verba, subjek, objek, dan unsur-unsur lainnya. Umum ditemukan dalam bahasa-bahasa asli Amerika dan Arktik.",
          "label": "Polisintesis"
        }
      }
    },
