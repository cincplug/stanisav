        "none": {
          "description": "Keine grammatikalische Markierung der Informationsquelle.",
          "label": "Keine"
        },
        "optional": {
          "description": "Evidentialitätsähnliche Marker existieren, sind aber nicht obligatorisch.",
          "label": "Optional"
        },
        "simple": {
