    "evidentiality": {
      "name": "Evidentialität",
      "values": {
        "complex": {
          "description": "Vier oder mehr Evidentialitätsunterscheidungen oder Evidentialität kombiniert mit Tempus/Aspekt.",
          "label": "Komplex"
