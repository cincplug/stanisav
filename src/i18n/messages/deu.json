    },
    "morphology": {
      "name": "Morphologie",
      "values": {
        "agglutinative": {
          "description": "Wörter werden durch das Aneinanderreihen von Affixen gebildet, wobei jedes Affix genau eine Bedeutung trägt. Die Teile bleiben klar erkennbar, wie zusammengesteckte Bausteine.",
          "label": "Agglutinierend"
        },
        "fusional": {
          "description": "Wörter verändern ihre Form durch Endungen und Präfixe, die mehrere grammatikalische Bedeutungen gleichzeitig bündeln. Eine einzelne Endung kann Geschlecht, Zahl und Kasus gleichzeitig ausdrücken, was die Teile schwer trennbar macht.",
          "label": "Flektierend"
        },
        "introflexive": {
          "description": "Grammatik ist von innen in das Wort eingebaut: Eine Konsonantenwurzel trägt die Kernbedeutung, während verschiedene Vokalmuster neue Wörter erzeugen. Zum Beispiel bezieht sich die arabische Wurzel k-t-b auf das Schreiben, und kataba, kitāb und kātib stammen alle davon ab.",
          "label": "Introflexiv"
        },
        "isolating": {
          "description": "Wörter bestehen typischerweise aus einzelnen Morphemen und ändern ihre Form nicht. Grammatik wird durch Wortstellung und separate Funktionswörter ausgedrückt, nicht durch Endungen oder Präfixe.",
          "label": "Isolierend"
        },
        "polysynthetic": {
          "description": "Ein einzelnes Wort kann ausdrücken, was andere Sprachen in einem ganzen Satz sagen würden, indem Verb, Subjekt, Objekt und andere Elemente zusammengefügt werden. Häufig in indigenen Sprachen Amerikas und der Arktis.",
          "label": "Polysynthetisch"
        }
      }
    },
