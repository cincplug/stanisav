    "maxClusterSize": {
      "name": "辅音群最大辅音数"
    },
    "morphology": {
      "name": "形态类型",
      "values": {
        "agglutinative": {
          "description": "单词通过逐一叠加词缀来构成，每个词缀承载恰好一个含义。各部分清晰可辨，如同拼接在一起的积木。",
          "label": "黏着语"
        },
        "fusional": {
          "description": "单词通过词尾和前缀来改变形式，这些词缀同时表达多种语法含义。一个词尾可能同时表示性、数和格，使各部分难以分离。",
          "label": "屈折语"
        },
        "introflexive": {
          "description": "语法从词内部构建：一组辅音词根承载核心含义，而贯穿其中的不同元音模式产生新词。例如，阿拉伯语词根 k-t-b 与书写相关，kataba、kitāb 和 kātib 均由此派生。",
          "label": "内屈折语"
        },
        "isolating": {
          "description": "单词通常由单个语素构成且形式不变。语法通过语序和独立虚词来表达，而非词尾或前缀。",
          "label": "孤立语"
        },
        "polysynthetic": {
          "description": "一个单词可以表达其他语言需要整句话才能表达的内容，通过将动词、主语、宾语及其他成分融合在一起。常见于美洲和北极地区的原住民语言。",
          "label": "多式综合语"
        }
      }
    },
