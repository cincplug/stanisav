          "description": "无信息来源的语法标记。",
          "label": "无"
        },
        "optional": {
          "description": "存在类证据性标记，但非强制使用。",
          "label": "可选"
        },
        "simple": {
          "description": "二元区分（通常为直接与间接/转述之分）。",
          "label": "简单"
