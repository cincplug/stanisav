{
  "Header": {
    "sortBy": {
      "type": "select",
      "options": [
        "alphabetically",
        "speakers",
        "family",
        "tonality",
        "morphology",
        "wordOrder",
        "wordOrderFlexibility",
        "evidentiality",
        "verbAspect",
        "phonemeCount",
        "caseCount",
        "nounClassCount",
        "maxConsonantClusterSize"
      ],
      "defaultValue": "alphabetically",
      "isShownInMenu": true,
      "compactMenuIcon": "SortIcon"
    },
    "labelContent": {
      "type": "select",
      "options": ["name", "nativeName", "isoCode"],
      "defaultValue": "name",
      "isShownInMenu": true
    },
    "labelSize": {
      "type": "select",
      "options": [1, 1.25, 1.5, 1.75, 2],
      "defaultValue": 1.5,
      "isVisual": true,
      "isShownInMenu": true
    },
    "isReverse": {
      "type": "checkbox",
      "defaultValue": false,
      "isShownInMenu": true
    },
    "isSegmented": {
      "type": "checkbox",
      "defaultValue": false,
      "isVisual": true,
      "isDesktopOnly": true,
      "isShownInMenu": true,
      "compactMenuIcon": "SegmentationIcon"
    },
    "isMenuExpanded": {
      "type": "checkbox",
      "defaultValue": false,
      "defaultIfLowEnd": true,
      "isShownInMenu": false
    },
    "isIdCardVisible": {
      "type": "checkbox",
      "defaultValue": false,
      "isDesktopOnly": true,
      "isShownInMenu": false
    },
    "hasLines": {
      "type": "checkbox",
      "defaultValue": true,
      "isDesktopOnly": false,
      "isShownInMenu": false
    },
    "isMyMesha": {
      "type": "checkbox",
      "defaultValue": false,
      "isShownInMenu": false
    },
    "isAutoplay": {
      "type": "checkbox",
      "defaultValue": true,
      "isShownInMenu": false
    },
    "isLuka": {
      "type": "checkbox",
      "defaultValue": true,
      "isShownInMenu": false
    }
  }
}
