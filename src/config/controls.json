{
  "Header": {
    "sortBy": {
      "type": "select",
      "options": [
        "alphabetically",
        "speakers",
        "family",
        "tonality",
        "morphology",
        "wordOrder",
        "wordOrderFlexibility",
        "evidentiality",
        "verbAspect",
        "phonemeCount",
        "caseCount",
        "nounClassCount",
        "maxClusterSize"
      ],
      "defaultValue": "alphabetically",
      "isShownInMenu": true,
      "compactMenuIcon": "SortIcon"
    },
    "labelContent": {
      "type": "select",
      "options": ["name", "nativeName", "isoCode"],
      "defaultValue": "name",
      "isShownInMenu": true
    },
    "labelSize": {
      "type": "select",
      "options": [1, 1.25, 1.5, 1.75, 2],
      "defaultValue": 1.5,
      "isVisual": true,
      "isShownInMenu": true
    },
    "isReverse": {
      "type": "checkbox",
      "defaultValue": false,
      "isShownInMenu": true
    },
    "isSegmented": {
      "type": "checkbox",
      "defaultValue": false,
      "isVisual": true,
      "isDesktopOnly": true,
      "isShownInMenu": true,
      "compactMenuIcon": "SegmentationIcon"
    },
    "isMenuExpanded": {
      "type": "checkbox",
      "defaultValue": false,
      "defaultIfLowEnd": true,
      "isShownInMenu": false
    },
    "isIdCardVisible": {
      "type": "checkbox",
      "defaultValue": false,
      "isDesktopOnly": true,
      "isShownInMenu": false
    }
  },
  "Scene": {
    "irrationality": {
      "type": "range",
      "min": 1,
      "max": 200,
      "step": 1,
      "defaultValue": 50,
      "isShownInMenu": true
    },
    "d4": {
      "type": "checkbox",
      "isVisual": true,
      "defaultValue": true,
      "isShownInMenu": true
    },
    "light": {
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "defaultValue": 1,
      "isShownInMenu": true
    },
    "rotateSpeed": {
      "type": "range",
      "min": 0.1,
      "max": 4,
      "step": 0.1,
      "defaultValue": 1,
      "isShownInMenu": true
    },
    "axis": {
      "type": "radio",
      "options": ["x", "y", "z"],
      "defaultValue": "y",
      "isShownInMenu": true
    },
    "sphereRadius": {
      "type": "range",
      "min": 1,
      "max": 50,
      "step": 1,
      "defaultValue": 22,
      "isShownInMenu": false
    },
    "isMyMesha": {
      "type": "checkbox",
      "defaultValue": false,
      "isShownInMenu": false
    },
    "isAutoplay": {
      "type": "checkbox",
      "defaultValue": true,
      "isShownInMenu": false
    },
    "isLuka": {
      "type": "checkbox",
      "defaultValue": true,
      "isShownInMenu": false
    }
  },
  "Colors": {
    "bgColor": {
      "type": "color",
      "defaultValue": "#070b0f",
      "isShownInMenu": true
    },
    "hue": {
      "type": "range",
      "min": 0,
      "max": 360,
      "step": 1,
      "defaultValue": 100,
      "isShownInMenu": true
    },
    "lightness": {
      "type": "range",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "defaultValue": 0.8,
      "isShownInMenu": true
    },
    "saturation": {
      "type": "range",
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "defaultValue": 0.2,
      "isShownInMenu": true
    }
  },
  "Camera": {
    "cameraX": {
      "type": "range",
      "min": -150,
      "max": 150,
      "step": 1,
      "defaultValue": 0,
      "isShownInMenu": false
    },
    "cameraY": {
      "type": "range",
      "min": -50,
      "max": 50,
      "step": 10,
      "defaultValue": 0,
      "isShownInMenu": false
    },
    "cameraZ": {
      "type": "range",
      "min": 100,
      "max": 150,
      "step": 10,
      "defaultValue": 120,
      "isShownInMenu": false
    },
    "switchDuration": {
      "type": "range",
      "min": 500,
      "max": 3000,
      "step": 100,
      "defaultValue": 1200,
      "isShownInMenu": true
    },
    "zoomDistance": {
      "type": "range",
      "min": 20,
      "max": 100,
      "step": 1,
      "defaultValue": 37,
      "isShownInMenu": true
    },
    "fov": {
      "defaultValue": 30,
      "isShownInMenu": false
    },
    "near": {
      "defaultValue": 0.1,
      "isShownInMenu": false
    },
    "far": {
      "defaultValue": 2000,
      "isShownInMenu": false
    }
  },
  "Motion": {
    "tension": {
      "type": "range",
      "min": 50,
      "max": 400,
      "step": 1,
      "defaultValue": 100,
      "isShownInMenu": true
    },
    "friction": {
      "type": "range",
      "min": 1,
      "max": 80,
      "step": 1,
      "defaultValue": 64,
      "isShownInMenu": true
    }
  },
  "Mesha": {
    "meshaSize": {
      "type": "range",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "defaultValue": 2,
      "isShownInMenu": true
    },
    "earSize": {
      "type": "range",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "defaultValue": 1.7,
      "isShownInMenu": true
    },
    "tongueSize": {
      "type": "range",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "defaultValue": 4,
      "isShownInMenu": true
    },
    "eyeX": {
      "type": "range",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "defaultValue": 0.6,
      "isShownInMenu": true
    },
    "eyeY": {
      "type": "range",
      "min": -2,
      "max": 2,
      "step": 0.1,
      "defaultValue": 2,
      "isShownInMenu": true
    },
    "eyeZ": {
      "type": "range",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "defaultValue": 2,
      "isShownInMenu": true
    },
    "eyeSize": {
      "type": "range",
      "min": 0.05,
      "max": 0.5,
      "step": 0.01,
      "defaultValue": 0.25,
      "isShownInMenu": true
    },
    "eyeProtrusion": {
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "defaultValue": 0.2,
      "isShownInMenu": false
    },
    "noseSize": {
      "type": "range",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "defaultValue": 0.4,
      "isShownInMenu": true
    },
    "teethSize": {
      "type": "range",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "defaultValue": 0.6,
      "isShownInMenu": true
    },
    "moustacheSize": {
      "type": "range",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "defaultValue": 0.5,
      "isShownInMenu": true
    }
  }
}
