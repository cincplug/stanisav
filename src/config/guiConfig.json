{
  "labelSize": {
    "type": "range",
    "label": "Label Size",
    "min": 0.1,
    "max": 3,
    "step": 0.1,
    "defaultValue": 2,
    "isUserEditable": true,
    "group": "Scene"
  },
  "sphereRadius": {
    "type": "range",
    "label": "Sphere radius",
    "min": 1,
    "max": 50,
    "step": 1,
    "defaultValue": 27,
    "isUserEditable": true,
    "group": "Scene"
  },
  "sortLanguagesBy": {
    "type": "radio",
    "label": "Sort Languages By",
    "options": [
      { "value": "group", "label": "Group" },
      { "value": "alphabetically", "label": "Alphabetically" },
      { "value": "speakers", "label": "Speakers' number" }
    ],
    "defaultValue": "group",
    "isUserEditable": true,
    "group": "Scene"
  },
  "labelContent": {
    "type": "radio",
    "label": "Display",
    "options": [
      { "value": "name", "label": "English names" },
      { "value": "nativeName", "label": "Native names" },
      { "value": "isoCode", "label": "ISO codes" }
    ],
    "defaultValue": "name",
    "isUserEditable": true,
    "group": "Scene"
  },
  "showInfo": {
    "type": "checkbox",
    "label": "Show Language Info",
    "defaultValue": false,
    "isUserEditable": false,
    "group": "Scene"
  },
  "isLuka": {
    "type": "checkbox",
    "label": "Luka Reads Samples",
    "defaultValue": true,
    "isUserEditable": true,
    "group": "Scene"
  },
  "showsVideoPreviews": {
    "type": "checkbox",
    "label": "Preview original",
    "defaultValue": false,
    "isUserEditable": false,
    "group": "Scene"
  },
  "backgroundColor": {
    "type": "color",
    "label": "Background",
    "defaultValue": "#222222",
    "isUserEditable": false,
    "group": "Colors"
  },
  "positionX": {
    "type": "range",
    "label": "Camera X",
    "min": -500,
    "max": 500,
    "step": 10,
    "defaultValue": 0,
    "isUserEditable": true,
    "group": "Camera"
  },
  "positionY": {
    "type": "range",
    "label": "Camera Y",
    "min": -500,
    "max": 500,
    "step": 10,
    "defaultValue": 0,
    "isUserEditable": true,
    "group": "Camera"
  },
  "positionZ": {
    "type": "range",
    "label": "Camera Z",
    "min": 50,
    "max": 500,
    "step": 10,
    "defaultValue": 120,
    "isUserEditable": true,
    "group": "Camera"
  },
  "fov": {
    "type": "range",
    "label": "Field of View",
    "min": 10,
    "max": 120,
    "step": 1,
    "defaultValue": 30,
    "isUserEditable": true,
    "group": "Camera"
  },
  "animationDuration": {
    "type": "range",
    "label": "Animation Duration",
    "min": 500,
    "max": 3000,
    "step": 100,
    "defaultValue": 1000,
    "isUserEditable": true,
    "group": "Camera"
  },
  "easingPower": {
    "type": "range",
    "label": "Easing Power",
    "min": -5,
    "max": 0,
    "step": 0.1,
    "defaultValue": -2,
    "isUserEditable": false,
    "group": "Camera"
  },
  "resetDelay": {
    "type": "range",
    "label": "Reset Delay",
    "min": 0,
    "max": 1000,
    "step": 50,
    "defaultValue": 100,
    "isUserEditable": false,
    "group": "Camera"
  },
  "focusDistance": {
    "type": "range",
    "label": "Focus Distance",
    "min": 10,
    "max": 200,
    "step": 5,
    "defaultValue": 40,
    "isUserEditable": true,
    "group": "Camera"
  },
  "near": {
    "type": "range",
    "label": "Near Plane",
    "min": 0.1,
    "max": 10,
    "step": 0.1,
    "defaultValue": 0.1,
    "isUserEditable": false,
    "group": "Camera"
  },
  "far": {
    "type": "range",
    "label": "Far Plane",
    "min": 1000,
    "max": 10000,
    "step": 100,
    "defaultValue": 2000,
    "isUserEditable": false,
    "group": "Camera"
  }
}
