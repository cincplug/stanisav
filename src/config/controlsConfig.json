  "ambientLightIntensity": {
    "group": "Lighting",
    "type": "range",
    "label": "Ambient Light Intensity",
    "min": 0,
    "max": 5,
    "step": 0.1,
    "defaultValue": 0.8,
    "isUserEditable": true
  },
