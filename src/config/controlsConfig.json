    "type": "range",
    "label": "Camera X",
    "min": -150,
    "max": 150,
    "step": 1,
    "defaultValue": 0,
    "isUserEditable": false,
    "group": "Camera"
  },
  "positionY": {
    "type": "range",
    "label": "Camera Y",
    "min": -50,
    "max": 50,
    "step": 10,
    "defaultValue": 0,
    "isUserEditable": false,
    "group": "Camera"
  },
  "positionZ": {
    "type": "range",
    "label": "Camera Z",
    "min": 100,
    "max": 150,
    "step": 10,
    "defaultValue": 120,
    "isUserEditable": false,
    "group": "Camera"
  },
  "fov": {
    "type": "range",
    "label": "Field of View",
    "min": 10,
    "max": 120,
    "step": 1,
    "defaultValue": 30,
    "isUserEditable": false,
    "group": "Camera"
  },
  "animationDuration": {
    "type": "range",
    "label": "Animation Duration",
    "min": 500,
    "max": 3000,
    "step": 100,
    "defaultValue": 1000,
