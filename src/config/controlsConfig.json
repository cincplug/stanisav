    "group": "Camera"
  },
  "focusDistance": {
    "type": "range",
    "label": "Focus Distance",
    "min": 20,
    "max": 100,
    "step": 5,
    "defaultValue": 40,
    "isUserEditable": true,
    "group": "Camera"
  },
  "near": {
    "type": "range",
    "label": "Near Plane",
    "min": 0.1,
    "max": 10,
    "step": 0.1,
    "defaultValue": 0.1,
    "isUserEditable": false,
    "group": "Camera"
  },
  "far": {
    "type": "range",
    "label": "Far Plane",
    "min": 1000,
    "max": 10000,
    "step": 100,
    "defaultValue": 2000,
    "isUserEditable": false,
    "group": "Camera"
  }
}
