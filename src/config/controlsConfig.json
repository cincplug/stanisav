{
  "labelSize": {
    "type": "range",
    "label": "Label Size",
    "min": 0.1,
    "max": 3,
    "step": 0.1,
    "defaultValue": 0.5,
    "isUserEditable": true,
    "group": "Scene"
  },
  "sphereRadius": {
    "type": "range",
    "label": "Sphere radius",
    "min": 1,
    "max": 50,
    "step": 1,
    "defaultValue": 27,
    "isUserEditable": true,
    "group": "Scene"
  },
  "sortLanguagesBy": {
    "type": "radio",
    "label": "Sort Languages By",
    "options": [
      { "value": "alphabetically", "label": "Alphabetically" },
      { "value": "group", "label": "Group" },
      { "value": "speakers", "label": "Speakers' number" }
    ],
    "defaultValue": "alphabetically",
    "isUserEditable": true,
    "group": "Scene"
  },
  "labelContent": {
    "type": "radio",
    "label": "Display",
    "options": [
      { "value": "name", "label": "English names" },
      { "value": "nativeName", "label": "Native names" },
      { "value": "isoCode", "label": "ISO codes" }
    ],
    "defaultValue": "name",
    "isUserEditable": true,
    "group": "Scene"
  },
  "isReverse": {
    "type": "checkbox",
    "label": "Reverse order",
    "defaultValue": false,
    "isUserEditable": true,
    "group": "Scene"
  },
  "isLoop": {
    "type": "checkbox",
    "label": "Loop playlist",
    "defaultValue": true,
    "isUserEditable": false,
    "group": "Scene"
  },
  "isLuka": {
    "type": "checkbox",
    "label": "Luka Reads Samples",
    "defaultValue": true,
    "isUserEditable": true,
    "group": "Scene"
  },
  "canEditColors": {
    "type": "checkbox",
    "label": "Can edit colors?",
    "defaultValue": false,
    "isUserEditable": false,
    "group": "Scene"
  },
  "showsVideoPreviews": {
    "type": "checkbox",
    "label": "Preview original",
    "defaultValue": false,
    "isUserEditable": false,
    "group": "Scene"
  },
  "backgroundColor": {
    "type": "color",
    "label": "Background",
    "defaultValue": "#000000",
    "isUserEditable": false,
    "group": "Colors"
  },
  "pointLightIntensity": {
    "group": "Lighting",
    "type": "range",
    "label": "Point Light Intensity",
    "min": 0,
    "max": 30,
    "step": 0.5,
    "defaultValue": 6,
    "isUserEditable": true
  },
  "pointLightDecay": {
    "group": "Lighting",
    "type": "range",
    "label": "Point Light Decay",
    "min": 0,
    "max": 1,
    "step": 0.1,
    "defaultValue": 0.1,
    "isUserEditable": true
  },
  "pointLightDistance": {
    "group": "Lighting",
    "type": "range",
    "label": "Point Light Distance",
    "min": 80,
    "max": 150,
    "step": 1,
    "defaultValue": 120,
    "isUserEditable": true
